Bootstrap: docker
From: rockylinux:9

# Image for speed-simu: the toolchain (gfortran, OpenMPI, METIS) and SPEED
# itself, cloned from https://bitbucket.org/ilmaz/speed and compiled at build
# time in /opt/speed. The cases, the meshes and the run script do NOT live in
# the image -- the repository is bind-mounted at /workspace when the container
# runs (see apptainer/shell.sh), so a new case or a new mesh needs no rebuild.
# Only a new version of SPEED does.
#
# SPEED's master has, since 2026-11-24, the three fixes once kept here as
# file overrides (bitbucket PRs #5, #6, #7): VTKWRITE T 100 XDMF (XDMF plus
# raw binary, the default), VTUBINARY or VTUASCII, and NOSTRAIN after it for
# the displacement only; a face shared by two elements only when they share
# its 4 corners (the crack tips of dtm_voxelization); nodal strain, stress and
# rotation averaged over all the elements at partition borders.
# Rocky 9, as the cluster: OpenMPI 4.1.1 with PMIx 3, UCX, libfabric and
# psm2 are the cluster's own packages, so the network stack matches its nodes.
# SPEED is compiled with gfortran 13 of gcc-toolset-13 (OMPI_FC), not the
# system's 11: SPEED includes mpif.h, so no MPI Fortran module is involved.
# python3 and numpy are there for monitors.py, which run_case.sh runs at the end
# of a run to gather the monitored points into one text file each.
# ssh is there for mpirun to start orted on the other nodes of a job, inside
# this same image (see SPEED_LAUNCH_AGENT in apptainer/shell.sh).

%labels
    Name speed-simu
    Description SPEED spectral elements code, compiled in the image

%environment
    export SPEED_FOLDER=/opt/speed
    export PATH=${SPEED_FOLDER}:/usr/lib64/openmpi/bin:${PATH}
    export LD_LIBRARY_PATH=/usr/lib64/openmpi/lib
    export PROJECT_DIR=/workspace
    # the shared memory transport of OpenMPI tries CMA, which needs ptrace
    # between the ranks and fails in a container; plain copies through /dev/shm
    export OMPI_MCA_btl_vader_single_copy_mechanism=none

%post
    set -e
    SPEED_FOLDER=/opt/speed

    # METIS is in EPEL, which needs CRB
    dnf install -y epel-release
    dnf config-manager --set-enabled crb
    dnf install -y openmpi openmpi-devel metis metis-devel \
        gcc-toolset-13-gcc-gfortran make git zstd vim-enhanced less openssh-clients \
        python3 python3-numpy
    dnf clean all
    rpm -q openmpi pmix ucx libfabric libpsm2 metis python3-numpy
    export PATH=/usr/lib64/openmpi/bin:${PATH}
    export OMPI_FC=/opt/rh/gcc-toolset-13/root/usr/bin/gfortran

    git clone --depth 1 https://bitbucket.org/ilmaz/speed.git ${SPEED_FOLDER}
    # written to a file: inside the container the clone belongs to root, and
    # git refuses to read a repository of another user (safe.directory)
    git -C ${SPEED_FOLDER} log -1 --format='%H %ad %s' --date=short > /opt/speed-commit.txt
    echo "compiler: $(mpif90 --version | head -n 1)" >> /opt/speed-commit.txt

    echo "SPEED commit:"
    cat /opt/speed-commit.txt

    # the Makefile points METIS at homebrew and leaves OPT_FLAGS undefined,
    # i.e. -O0: both are overridden on the make command line
    make -C ${SPEED_FOLDER} -j "$(nproc)" \
        OPT_FLAGS=-O3 \
        METIS_INCLUDE_FLAGS=-I/usr/include \
        "METIS_LD_FLAGS=-L/usr/lib64 -lmetis"
    rm -f ${SPEED_FOLDER}/*.o ${SPEED_FOLDER}/*.mod

    # mount points for the bind-mounted repository, data and output
    mkdir -p /workspace /workspace/data /workspace/output

%runscript
    cd ${PROJECT_DIR:-/workspace}
    if [ $# -eq 0 ]; then
        exec /bin/bash
    fi
    exec "$@"

%test
    test -x /opt/speed/SPEED
    if ldd /opt/speed/SPEED | grep "not found"; then
        exit 1
    fi
    echo "SPEED $(cat /opt/speed-commit.txt)"
    mpirun --version | head -n 1

%help
    speed-simu -- SPEED, compiled in /opt/speed (on PATH).

    The cases are NOT baked into the image: bind the repository at /workspace.
    apptainer/shell.sh does that, with separately bindable data and output:

        source apptainer/shell.sh                                  # shell
        source apptainer/shell.sh -- bash run_case.sh -n 4 cases/rialba_source
        apptainer/submit.sh -- bash run_case.sh cases/rialba_source # PBS job

    Built SPEED commit: /opt/speed-commit.txt
